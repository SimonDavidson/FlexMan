#! /usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Simon Davidson, University of Manchester
# Authors      : Simon Davidson & Claude
# Created      : 2026-06-30
# Last modified: 2026-11-21
#
# Focused F9 (gapped-activation weight indexing) confirmation for annAcc:
# full-chip ann_processor with sp_skip_neuron=1 + np_bias_en=0, gapped 8-bit MAC
# activations, all weight sizes x full/sparse/conv x per-port stalls, connectivity
# golden + stall-invariance on syn_curr.
# Swept over NLANE = 1 (original), 2, 4 (tile path + legacy fallback for sparse/conv/other widths).
set -u
fail=0
for NL in 1 2 4; do
  echo "=== tb_acc_ann_stress NLANE=$NL ==="
  xrun -sv -timescale 1ns/1ps -access wrc -top tb_acc_ann_stress -define NLANE=$NL \
    acc_snn_processor.v spike_processing.v ann_tile_path.v ann_tile_sp.v ann_lane_mac.v act_index_generator.v \
    weight_generator.v syn_curr_update.v update_state_for_neuron.v \
    neuron_processing.v ../shared/dataline_cache_with_xy.v \
    ../shared/slice_and_align.v ../shared/packer.v tb_acc_ann_stress.v \
    ${COV_ARGS:-} > xrun_annstress_NL$NL.log 2>&1
  if grep -q -E "FAIL|\*E,|\*F," xrun_annstress_NL$NL.log || ! grep -q PASS xrun_annstress_NL$NL.log; then echo "FAIL NLANE=$NL"; fail=1; else echo PASS; fi
done
exit $fail
