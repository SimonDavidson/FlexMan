# Focused F9 (gapped-activation weight indexing) confirmation for annAcc:
# full-chip ann_processor with sp_skip_neuron=1 + np_bias_en=0, gapped 8-bit MAC
# activations, all weight sizes x full/sparse/conv x per-port stalls, connectivity
# golden + stall-invariance on syn_curr.
xrun -sv -timescale 1ns/1ps -access wrc -top tb_acc_ann_stress \
  acc_snn_processor.v spike_processing.v act_index_generator.v \
  weight_generator.v syn_curr_update.v update_state_for_neuron.v \
  neuron_processing.v ../shared/dataline_cache_with_xy.v \
  ../shared/slice_and_align.v ../shared/packer.v tb_acc_ann_stress.v \
  ${COV_ARGS:-}
