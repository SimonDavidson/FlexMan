#
# PROG_MEM_SYNC: scheduler fetching from a 1-cycle SRAM program store, run in
# lockstep against the combinational-store oracle plus a negative control.
# PS_EXTRA="..." appends xrun args (the regression runner passes its own argv).
xrun -sv -timescale 1ns/1ps -access r -top tb_prog_sync \
  sch_entry.v sch_table.v buffer_state_entry.v acc_hw_buffer_tracker.v \
  sch_buffer_state.v prog_cache.v scheduler.v tb_prog_sync.v ${PS_EXTRA:-}
