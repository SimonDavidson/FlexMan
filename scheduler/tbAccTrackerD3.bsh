# acc_hw_buffer_tracker DEPTH=3 (gen_depthn) against a behavioural in-order
# queue, and DEPTH=3/2 identical to DEPTH=1 with acc_ready_next_i low.
xrun -sv -timescale 1ns/1ps -access wrc -top tb_acc_tracker_d3 \
  acc_hw_buffer_tracker.v tb_acc_tracker_d3.v
