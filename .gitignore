# Ignore everything by default
*

# Always allow directory traversal
!*/

# Hardware design files
!*.v
!*.vh
!*.bsh
!*.sh
!*.tcl
!*.xdc

# Vivado project output (generated by create_vivado_project.tcl)
vivado/

# Documentation
!*.md
!README
!LICENSE
!LICENSE.*

# Python deployment toolchain (tools/) — back-end source + packaging only.
# egg-info / __pycache__ / *.pyc stay ignored (they are not .py/.toml).
!tools/**/*.py
!tools/**/*.toml

# Claude Code development files
CLAUDE.md

# Generated sim copies — staged from the Bosch front-end artifacts by
# siren_detector/sim_siren_e2e.bsh (flexman_program.hex is already ignored
# by the default-deny rule; these two need explicit ignores past !*.vh)
siren_detector/cfg_mem.vh
siren_detector/static_config.vh
