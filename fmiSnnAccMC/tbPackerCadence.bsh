#
# Dedicated multi-packer cadence test (F8): drives the REAL
# update_state_for_neuron producer + REAL packer x4 wired exactly as
# neuron_processing, with wait-honouring writeback SRAMs, to confirm/characterise
# the sub-32-bit slice writeback corruption.
xrun -sv -timescale 1ns/1ps -access wrc -top tb_packer_cadence \
  ../shared/packer.v update_state_for_neuron.v tb_packer_cadence.v \
  ${COV_ARGS:-}
