# Phase-0 self-test: validates verif/ library + np_ref golden vs real snnAcc DUT.
# Run from the verif/ directory.
xrun -sv -timescale 1ns/1ps -access wrc -top tb_np_ref_selftest \
  ../snnAcc/update_state_for_neuron.v \
  tb_np_ref_selftest.v ${COV_ARGS:-}
