#! /usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Simon Davidson, University of Manchester
# Authors: Simon Davidson & Claude | Created 2026-08-20 | Last modified 2026-08-20
#
# tb_hu_compute with FMAX_PIPE=1 — the configuration the deployment tops actually
# SHIP (they pass FMAX_HU_PIPE=1), and which until 2026-08-20 had NO unit-level
# coverage at all: the testbench never overrode the parameter, so this path was
# only ever exercised full-chip.
#
# Also asserts throughput: 2*mul_total + 6 cyc/element, i.e. 10 for 16-bit Z,
# 8 for 8-bit, 14 for 32-bit. The 10 matches the full-chip profile exactly.
xrun -sv -timescale 1ns/1ps -access wrc -top tb_hu_compute \
  -define HU_FMAX_PIPE \
  hu_compute.v tb_hu_compute.v
