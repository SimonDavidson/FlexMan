#
# Full-chip stress testbench for acc_snn_processor: every connectivity mode
# (full/sparse/conv) x every weight size x neuron-update on/off x np_mode, with
# wait-honouring SRAM BFMs injecting per-port back-pressure on all seven ports
# (incl. syn_curr arbiter contention).  Two oracles: software golden (np_ref_lif +
# connectivity model) and stall-invariance (stalled run == no-stall run).
xrun -sv -timescale 1ns/1ps -access wrc -top tb_acc_snn_stress \
  acc_snn_processor.v spike_processing.v act_index_generator.v \
  weight_generator.v syn_curr_update.v update_state_for_neuron.v \
  neuron_processing.v ../shared/dataline_cache_with_xy.v \
  ../shared/slice_and_align.v ../shared/packer.v tb_acc_snn_stress.v \
  ${COV_ARGS:-}
