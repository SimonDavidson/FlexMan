#
# Sweeps syn_curr_accum_wide over EB in {8,16} x LANES in {1,2,4} (LANES<=EPW).
# Fails the whole script if any config does not print PASS.
set -u
RTL="syn_curr_accum_wide.v tb_syn_curr_accum_wide.v"
fail=0
for EB in 8 16; do
  for LANES in 1 2 4; do
    EPW=$((32 / EB))
    if [ "$LANES" -gt "$EPW" ]; then continue; fi
    echo "=== syn_curr_accum_wide EB=$EB LANES=$LANES ==="
    log="xrun_accum_EB${EB}_L${LANES}.log"
    xrun -sv -timescale 1ns/1ps -access wrc -top tb_syn_curr_accum_wide \
         -define EB=$EB -define LANES=$LANES $RTL > "$log" 2>&1
    if grep -q '^PASS$' "$log" && ! grep -q '^FAIL' "$log"; then
      echo "  PASS  (EB=$EB LANES=$LANES)"
    else
      echo "  FAIL  (EB=$EB LANES=$LANES)  -- see $log"
      grep -E '^FAIL|Error|\*E' "$log" | head -10
      fail=1
    fi
  done
done
echo "------------------------------------------------------------"
if [ "$fail" -eq 0 ]; then echo "ALL SYN_CURR_ACCUM_WIDE CONFIGS PASS"; else echo "SYN_CURR_ACCUM_WIDE: SOME CONFIGS FAILED"; fi
exit $fail
