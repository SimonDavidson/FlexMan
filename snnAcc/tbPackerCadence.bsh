#
# Dedicated multi-packer cadence test (F8) for snnAcc: drives the REAL
# update_state_for_neuron producer + REAL packer x3 wired exactly as
# neuron_processing, with wait-honouring writeback SRAMs, to confirm the
# sub-32-bit slice writeback stays correct under WRITE-side back-pressure.
xrun -sv -timescale 1ns/1ps -access wrc -top tb_packer_cadence \
  ../shared/packer.v update_state_for_neuron.v tb_packer_cadence.v \
  ${COV_ARGS:-}
