#
# Unit testbench for fmiSnnAcc/neuron_processing (FMI per-neuron-decay +
# adaptive-threshold neuron stage). Drives whole layers of neurons and checks
# every memory write-back against the np_ref_fmi golden, covering both the
# plain (has_ada=0) and adaptive (has_ada=1) datapaths.
xrun -sv -timescale 1ns/1ps -access wrc -top tb_neuron_processing \
  ../shared/dataline_cache_with_xy.v ../shared/slice_and_align.v packer.v \
  update_state_for_neuron.v neuron_processing.v tb_neuron_processing.v \
  ${COV_ARGS:-}
