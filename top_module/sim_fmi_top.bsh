# Simulate the FMI top-level integration testbench (Stage C / C1).
# Run from this directory (top_module/). -access wrc enables the tb's
# hierarchical references (u_dut.fmi_busy, pool bank .mem backdoor).
xrun -sv -timescale 10ps/1ps -access wrc -top tb_fmi_top \
  tb_fmi_top.v \
  fmi_top.v \
  ../shared/shared_pool.v \
  ../scheduler/scheduler.v \
  ../scheduler/sch_table.v \
  ../scheduler/sch_entry.v \
  ../scheduler/sch_buffer_state.v \
  ../scheduler/buffer_state_entry.v \
  ../scheduler/acc_hw_buffer_tracker.v \
  ../scheduler/prog_cache.v \
  ../config_manager/config_manager.v \
  ../fmiSnnAccMC/acc_fmiSnnMC_processor.v \
  ../fmiSnnAccMC/spike_processing.v \
  ../fmiSnnAccMC/act_index_generator.v \
  ../fmiSnnAccMC/weight_generator.v \
  ../fmiSnnAccMC/syn_curr_update.v \
  ../fmiSnnAccMC/update_state_for_neuron.v \
  ../fmiSnnAccMC/neuron_processing.v \
  ../shared/dataline_cache_with_xy.v \
  ../shared/slice_and_align.v \
  ../shared/packer.v
